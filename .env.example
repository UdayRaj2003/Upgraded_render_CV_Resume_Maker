# OpenAI-compatible AI endpoint (required)
RESUME_ENGINE_API_BASE_URL=https://api.example.com/v1
RESUME_ENGINE_MODEL_NAME=your-model-name

# API keys (same model). Prefer API_KEYS for failover; API_KEY still works alone.
# Comma / semicolon / newline separated. On 429/auth/5xx the client switches keys.
RESUME_ENGINE_API_KEYS=your-api-key-1,your-api-key-2,your-api-key-3
# Optional legacy single key (merged if not already in API_KEYS)
RESUME_ENGINE_API_KEY=your-api-key-1

# Optional
RESUME_ENGINE_MAX_RETRIES=3
# Console progress UI (1/0). Default: on
RESUME_ENGINE_CONSOLE=1

# Generated PDF filename (default: same as master YAML stem, e.g. Uday_Resume.pdf)
RESUME_ENGINE_OUTPUT_FILENAME=Uday_Resume.pdf
